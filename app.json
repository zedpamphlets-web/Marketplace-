{
  "expo": {
    "name": "Marketplace",
    "slug": "marketplace-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "marketplaceapp",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourcompany.marketplaceapp",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.yourcompany.marketplaceapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563EB"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Marketplace to access your photos for category and product images."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "YOUR-EAS-PROJECT-ID"
      },
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "paymentApiUrl": ""
    }
  }
}
